# 1. 업로드된 사용자 데이터 제외 (절대 Git에 올리지 않음!)
backend/uploads/*
!backend/uploads/.gitkeep

# 2. 보안 민감 파일 제외
.env
backend/.env
frontend/.env.local

# 3. 파이썬 임시/캐시 파일 제외
__pycache__/
*.py[cod]
*$py.class
backend/venv/

# 4. 프론트엔드 빌드 및 의존성 제외
frontend/node_modules/
frontend/.next/
frontend/out/

# 5. OS 및 에디터 임시 파일
.DS_Store
Thumbs.db
.vscode/
